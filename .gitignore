# Dict shards are committed — they're static assets served by Cloudflare Pages.
# Regenerate with: node build/build-dict-shards.js
pagefind/
pagefind-old/
dict-bundled/
node_modules/

# Deploy-time staging tree built by `npm run dist` / `npm run deploy`
# (build/make-dist.js). Ephemeral, rebuilt from scratch every run — the
# stamped shell (?v=<BUILD_ID>) and the immutable `_headers` only ever
# exist here, never in the repo. See README.md "Caching architecture".
dist/

# Generated by `npm run build:search`. Bigram inverted index + per-doc
# normalized text shards + english corpus blob. Regenerate locally
# before deploy; ~5k files, too noisy for git.
data/search/

# Generated by `npm run build:seo`. Hash cache used to short-circuit
# SEO regeneration when corpus inputs are unchanged.
data/seo-cache/

# Local preview copy of the Zen termbase. The published dictionary is served
# from the CbetaZenTranslations data repo; this file exists only so the
# dictionary can be reviewed on localhost before it is pushed. Never ship it.
/termbase.v2.json
/termbase.index.json
/termbase/
