# Cache strategy: index shards immutable (filenames are content-hashed:
# {YY}-{sha256[:6]}.bin). TEXT shards are NOT content-hashed — they live at
# fixed names (text/{XXX}.bin) whose content changes across deploys (the
# builder renumbers all docIds on every corpus walk), so they must
# revalidate like the manifest; a year-long immutable cache would map
# docIds to the wrong documents after a redeploy. Manifest/docs.txt 60s
# revalidate, english.jsonl 300s revalidate.

/sitemap.xml
  Content-Type: application/xml; charset=utf-8

/robots.txt
  Content-Type: text/plain; charset=utf-8

/data/search/bigram/shards/*
  Cache-Control: public, max-age=31536000, immutable

/data/search/bigram/unigram/*
  Cache-Control: public, max-age=31536000, immutable

/data/search/text/*
  Cache-Control: public, max-age=60, must-revalidate

/data/search/bigram/manifest.json
  Cache-Control: public, max-age=60, must-revalidate

/data/search/bigram/docs.txt
  Cache-Control: public, max-age=60, must-revalidate

/data/search/english.jsonl
  Cache-Control: public, max-age=300, must-revalidate

# Service worker must revalidate on every load so a deploy rolls out promptly.
/sw.js
  Cache-Control: no-cache

# App shell: revalidate on every load. These files are small and ETag'd, so a
# revalidation is a cheap 304 — worth it to guarantee a deploy is live at once.
# This is NOT redundant with the service worker's network-first strategy: the
# SW's own fetch() goes through the HTTP cache, so without no-cache here a
# network-first request could still be answered from a stale HTTP entry.
# no-cache (revalidate before use), NOT no-store — the entry must stay stored
# so the SW can still serve it offline.
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

# make-dist rewrites the Cache-Control value of exactly these four rules
# (/app.js, /style.css, /views/*, /lib/*) to immutable in dist/. Edit values
# here only in coordination with build/make-dist.js. Never ADD a second rule
# for these paths — Cloudflare joins duplicate headers with commas and
# "no-cache, immutable" means no-cache.
/app.js
  Cache-Control: no-cache

/style.css
  Cache-Control: no-cache

# app.js imports these; if they went stale the app would freeze with the shell.
/views/*
  Cache-Control: no-cache

/lib/*
  Cache-Control: no-cache

/manifest.json
  Cache-Control: public, max-age=3600
